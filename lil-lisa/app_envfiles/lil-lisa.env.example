LIL_LISA_SLACK_USERID=your-bot-user-id-here
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_APP_TOKEN=xapp-your-app-token-here
CHANNEL_ID_IDDM=your-iddm-channel-id-here
CHANNEL_ID_IDA=your-ida-channel-id-here
# One shared admin channel for slash-command authorization, pipeline alerts,
# and inline-tagged test questions (e.g. `@Lil Lisa [IDA] your question`).
ADMIN_CHANNEL_ID=your-admin-channel-id-here
# CHANNEL_ID_IDA / _IDDM / _IDO are the product question channels. The nightly
# expert-correction scan reads these variables here. The API does not.
# Experts are a Slack user group per product (Slack app needs the usergroups:read scope).
# Either the group ID (S0123ABCD, from usergroups.list) or its @handle
# (@rocknbot-certified-ida-experts); a handle is resolved to the ID at first use.
# REQUIRED: the bot refuses to start without EXPERT_GROUP_ID_IDA and _IDDM.
EXPERT_GROUP_ID_IDA=your-expert-usergroup-id-here
EXPERT_GROUP_ID_IDDM=your-expert-usergroup-id-here
# How long expert group membership is cached before Slack is asked again (seconds, default 300)
# EXPERT_GROUP_CACHE_SECONDS=300
AUTHENTICATION_KEY=your-auth-key-here
# Base URL of LilLisa_Server. The harvester posts channel state, threads, and
# finalize here. Absent or blank falls back to http://127.0.0.1:8000, which is
# correct only when this process and the API share a network namespace.
# The API does not read this variable; finalize reloads the index in-process.
LIL_LISA_SERVER_URL=http://127.0.0.1:8000/
MAX_LENGTH=3000
# One tech-support channel for every product. Only this process reads it.
# Optional: if unset, the escalate button is omitted and the nightly
# techsupport-channel pass is skipped.
TECHSUPPORT_CHANNEL_ID=your-techsupport-channel-id-here
# Optional: how often this process checks whether a channel scan is due
# (minutes, default 60). Real work is still gated by
# TECHSUPPORT_SYNC_INTERVAL_HOURS on the API.
# TECHSUPPORT_PIPELINE_TICK_MINUTES=60

# Optional -- only needed if IDO product support is configured
# CHANNEL_ID_IDO=
# EXPERT_GROUP_ID_IDO=
