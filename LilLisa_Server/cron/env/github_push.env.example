# Classic PAT or fine-grained token. Copy this file, set GITHUB_TOKEN, and do not commit the real file.
GITHUB_TOKEN=
GITHUB_REPO_URL=https://github.com/your-org/your-techsupport-qa-repo.git
# Optional. Only set this if the golden QA pairs repo (QA_PAIRS_GITHUB_REPO_URL
# in lillisa_server.env) needs a different PAT than GITHUB_TOKEN above.
# src/golden_qa_sync.py prefers this one and falls back to GITHUB_TOKEN.
QA_PAIRS_GITHUB_TOKEN=
