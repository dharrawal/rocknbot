# Ignore uv virtual environment
.venv/

# Ignore mypy cache
.mypy_cache/

# Ignore app environment files
env/*
!env/*.example

# Ignore tool-specific credential env files
scripts/env/*
!scripts/env/*.example

# Ignore nightly techsupport sync local state
scripts/techsupport_sync_state.json

# Ignore techsupport contextual re-embed local state
scripts/techsupport_reembed_state.json

# Ignore techsupport expert-review sync local state
scripts/techsupport_review_state.json

# Ignore techsupport escalation-thread related-entry tags local state
scripts/techsupport_thread_tags.json

# Ignore one-time historical import/revert local run-state files
scripts/historical_import_state.json
scripts/historical_import_production_state.json
scripts/historical_revert_state.json

# Ignore Docker ignore files
.dockerignore

# Ignore Python bytecode cache
__pycache__/

# Ignore test configuration
conftest.py

# Ignore tox configuration
tox.ini

# Ignore contents of speedict folder
speedict/*

# Ignore contents of lancedb folder

lancedb/*/_indices


# Ignore passwords
passwords/

# Ignore production Slack harvest test-pull output
data/historical_import/production_test_pull*.txt

# Ignore test-workspace Slack harvest pull output
data/historical_import/test_harvest_pull*.txt
